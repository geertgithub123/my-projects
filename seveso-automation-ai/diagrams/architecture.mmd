      OBJ[Document object store]
      VEC[Vector store]
    end

    subgraph AI["Local AI"]
      EMB[Embedding model]
      LLM[Local LLM]
    end

    N8N[n8n workflows]
  end

  OP --> PROXY
  LAB --> PROXY
  MGT --> PROXY
